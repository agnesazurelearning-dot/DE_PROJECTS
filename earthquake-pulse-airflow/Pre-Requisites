Then Postgres, and the two databases this project needs (one for
Airflow's own metadata, one for the bronze/silver/gold data):

```bash
sudo apt install -y postgresql postgresql-contrib
sudo service postgresql start
sudo -u postgres psql -c "CREATE USER airflow WITH PASSWORD 'airflow';"
sudo -u postgres psql -c "CREATE DATABASE airflow_meta OWNER airflow;"
sudo -u postgres psql -c "CREATE USER analytics WITH PASSWORD 'analytics';"
sudo -u postgres psql -c "CREATE DATABASE earthquake_analytics OWNER analytics;"
```

# sanity check -- this must print a path INSIDE this project's venv/ folder,
# not /usr/bin/pip -- if it doesn't, don't proceed, see troubleshooting below
```bash
which pip

AIRFLOW_VERSION=2.9.3
PYTHON_VERSION="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
CONSTRAINT_URL="https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt"

python3 -m pip install "apache-airflow==${AIRFLOW_VERSION}" -r requirements.txt \
  --constraint "${CONSTRAINT_URL}"
```
